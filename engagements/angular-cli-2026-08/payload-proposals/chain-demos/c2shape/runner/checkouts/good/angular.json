{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "app": {
      "projectType": "application",
      "root": "",
      "i18n": { "sourceLocale": "en", "locales": { "fr": { "translation": "src/locale.fr.xlf" } } },
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": { "outputPath": "dist/app" }
        }
      }
    }
  }
}
