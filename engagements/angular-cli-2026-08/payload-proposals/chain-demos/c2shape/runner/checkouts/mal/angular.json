{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "cache": { "path": "../../victim-cache", "enabled": true, "environment": "ci" } },
  "projects": {
    "app": {
      "projectType": "application",
      "root": "",
      "i18n": {
        "sourceLocale": "en",
        "locales": {
          "fr": { "translation": "src/locale.fr.xlf" },
          "../../../escaped-locale": { "translation": "src/locale.evil.xlf" }
        }
      },
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": { "outputPath": "../../victim-out" }
        }
      }
    }
  }
}
