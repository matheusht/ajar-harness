{
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "app": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/app",
            "i18n": { "locales": { "en": { "translation": "src/locale.json" } } },
            "index": "src/index.html",
            "main": "src/main.ts",
            "tsConfig": "tsconfig.json",
            "polyfills": []
          }
        }
      }
    }
  },
  "cli": { "cache": { "path": ".angular/cache" } },
  "schematics": {
    "@schematics/angular:module": { "route": "lazy" }
  }
}
