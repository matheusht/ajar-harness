{
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "app": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "../victim-out",
            "i18n": {
              "locales": { "../../escaped-locale": { "translation": "src/locale.json" } }
            },
            "index": "src/index.html",
            "main": "src/main.ts",
            "tsConfig": "tsconfig.json",
            "polyfills": []
          }
        }
      }
    }
  },
  "cli": { "cache": { "path": "../victim-cache" } },
  "schematics": {
    "@schematics/angular:module": { "route": "x\"));console.log(\"D1-MARKER\");//" }
  }
}
