@@ -0,0 +1,110 @@
+import {
+  MAX_MODEL_LENGTH,
+  TARGET_FILES,
+  isInScope,
+  parseDeprecations,
+  validatePair,
+} from './update-models.js';
+
+describe('validatePair', () => {
+  it('accepts valid gemini -> gemini pairs', () => {
+    expect(validatePair('gemini-2.0-flash', 'gemini-3.1-flash-lite')).toBeNull();
+    expect(validatePair('gemini-2.5-pro-preview-09-2025', 'gemini-3.1-pro-preview')).toBeNull();
+    expect(
+      validatePair('gemini-2.5-flash-native-audio-preview-12-2025', 'gemini-3.1-flash-live-preview'),
+    ).toBeNull();
+    expect(validatePair('gemini-robotics-er-1.6-preview', 'gemini-robotics-er-2-preview')).toBeNull();
+  });
+
+  it('rejects empty model or replacement', () => {
+    expect(validatePair('', 'gemini-3.1-flash-lite')).not.toBeNull();
+    expect(validatePair('gemini-2.0-flash', '')).not.toBeNull();
+  });
+
+  it('rejects values exceeding the length cap', () => {
+    const tooLong = `gemini-${'a'.repeat(MAX_MODEL_LENGTH)}`;
+    expect(validatePair(tooLong, 'gemini-3.1-flash-lite')).not.toBeNull();
+    expect(validatePair('gemini-2.0-flash', tooLong)).not.toBeNull();
+  });
+
+  it('rejects disallowed characters on either side', () => {
+    for (const bad of ['"', "'", '`', '{', '}', '\\', '\n', ' ', '<', '$', ';', '|', '&']) {
+      expect(validatePair(`gemini-2.0${bad}flash`, 'gemini-3.1-flash-lite')).not.toBeNull();
+      expect(validatePair('gemini-2.0-flash', `gemini-3.1${bad}flash`)).not.toBeNull();
+    }
+  });
+
+  it('rejects identical model and replacement', () => {
+    expect(validatePair('gemini-2.0-flash', 'gemini-2.0-flash')).not.toBeNull();
+  });
+});
+
+describe('isInScope', () => {
+  it('accepts only pairs where both sides start with gemini-', () => {
+    expect(isInScope('gemini-2.0-flash', 'gemini-3.1-flash-lite')).toBeTrue();
+    expect(isInScope('text-embedding-004', 'gemini-embedding-2')).toBeFalse();
+    expect(isInScope('gemini-2.0-flash', 'imagen-4.0-generate-001')).toBeFalse();
+  });
+});
+
+describe('parseDeprecations', () => {
+  const row = (model: string, replacement: string) =>
+    `<tr><td><code>${model}</code></td><td>description</td><td>date</td>` +
+    `<td><code>${replacement}</code></td></tr>`;
+
+  it('extracts in-scope gemini -> gemini pairs', () => {
+    const html = `<table><tbody>${row('gemini-2.0-flash', 'gemini-3.1-flash-lite')}</tbody></table>`;
+    const result = parseDeprecations(html);
+    expect(result.replacements.get('gemini-2.0-flash')).toBe('gemini-3.1-flash-lite');
+    expect(result.skippedRows).toEqual([]);
+  });
+
+  it('skips out-of-scope rows with a non-gemini deprecated model', () => {
+    const html = `<table><tbody>${row('text-embedding-004', 'gemini-embedding-2')}</tbody></table>`;
+    const result = parseDeprecations(html);
+    expect(result.replacements.size).toBe(0);
+    expect(result.skippedRows.length).toBe(1);
+  });
+
+  it('skips rows where the replacement is not a gemini model', () => {
+    const html = `<table><tbody>${row('gemini-2.0-flash', 'imagen-4.0-generate-001')}</tbody></table>`;
+    const result = parseDeprecations(html);
+    expect(result.replacements.size).toBe(0);
+    expect(result.skippedRows.length).toBe(1);
+  });
+
+  it('skips layout rows with a colspan attribute', () => {
+    const html =
+      `<table><tbody><tr><td colspan="4">layout spacer</td></tr>` +
+      `${row('gemini-2.0-flash', 'gemini-3.1-flash-lite')}</tbody></table>`;
+    const result = parseDeprecations(html);
+    expect(result.replacements.size).toBe(1);
+  });
+
+  it('fails closed when the page has no expected table structure', () => {
+    expect(() => parseDeprecations('<html><body>unexpected page</body></html>')).toThrow();
+    expect(() => parseDeprecations('')).toThrow();
+  });
+
+  it('skips data rows with an empty replacement (new-model announcement rows)', () => {
+    const missingReplacement = `<table><tbody><tr><td><code>gemini-3.6-flash</code></td>` +
+      `<td>description</td><td>date</td><td></td></tr></tbody></table>`;
+    const result = parseDeprecations(missingReplacement);
+    expect(result.replacements.size).toBe(0);
+    expect(result.skippedRows.length).toBe(1);
+  });
+
+  it('skips data rows with an empty model cell', () => {
+    const missingModel = `<table><tbody><tr><td></td>` +
+      `<td>description</td><td>date</td><td><code>gemini-3.6-flash</code></td></tr></tbody></table>`;
+    const result = parseDeprecations(missingModel);
+    expect(result.replacements.size).toBe(0);
+    expect(result.skippedRows.length).toBe(1);
+  });
+});
+
+describe('TARGET_FILES', () => {
+  it('only lists files that legitimately hold model strings', () => {
+    expect(TARGET_FILES).toEqual(['github-actions/labeling/issue/lib/issue-labeling.ts']);
+  });
+});
