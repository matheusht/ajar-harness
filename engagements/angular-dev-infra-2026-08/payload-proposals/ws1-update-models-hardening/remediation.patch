diff --git a/.github/local-actions/update-models/lib/update-models.ts b/.github/local-actions/update-models/lib/update-models.ts
new file mode 100644
index 0000000..4da2345
--- /dev/null
+++ b/.github/local-actions/update-models/lib/update-models.ts
@@ -0,0 +1,266 @@
+/**
+ * @license
+ * Copyright Google LLC
+ *
+ * Use of this source code is governed by an MIT-style license that can be
+ * found in the LICENSE file at https://angular.io/license
+ */
+
+import * as core from '@actions/core';
+import {readFile, writeFile} from 'node:fs/promises';
+
+/** Stable endpoint documenting Gemini model deprecations and their replacements. */
+export const DEPRECATIONS_URL = 'https://ai.google.dev/gemini-api/docs/deprecations';
+
+/**
+ * Explicit allowlist of repository files that legitimately hold Gemini model
+ * strings. The updater NEVER writes outside of this list. This replaces the
+ * previous repository-wide glob for all `.ts`, `.yml`, and `.yaml` files
+ * (which also matched dotfiles and `.github/workflows`). Any file that starts
+ * holding model strings must be added here explicitly (and reviewed) before
+ * the updater is allowed to touch it.
+ */
+export const TARGET_FILES: readonly string[] = [
+  'github-actions/labeling/issue/lib/issue-labeling.ts',
+];
+
+/** Hard cap on the length of any model name accepted from the deprecations page. */
+export const MAX_MODEL_LENGTH = 100;
+
+/**
+ * Allowlist charset for model names. Any value containing a character outside
+ * of this charset (e.g. quotes, backticks, braces, backslashes, newlines,
+ * spaces, `<`, `$`, `;`) is rejected, which keeps every accepted value safe to
+ * embed verbatim into TypeScript string literals and YAML scalars.
+ */
+const MODEL_NAME_PATTERN = /^[a-zA-Z0-9][a-zA-Z0-9._-]*$/;
+
+/** Result of parsing the deprecations page. */
+export interface DeprecationParseResult {
+  /** In-scope (gemini -> gemini) replacement pairs. */
+  replacements: Map<string, string>;
+  /** Rows that were parsed but skipped as out of scope. Never applied or written. */
+  skippedRows: string[];
+}
+
+/**
+ * Validates a single in-scope (deprecated model, replacement model) pair.
+ * Returns a human-readable failure reason, or `null` when the pair is safe.
+ */
+export function validatePair(model: string, replacement: string): string | null {
+  if (!model || !replacement) {
+    return 'model or replacement is empty';
+  }
+  if (model.length > MAX_MODEL_LENGTH || replacement.length > MAX_MODEL_LENGTH) {
+    return `model/replacement exceeds the ${MAX_MODEL_LENGTH} character cap`;
+  }
+  if (!MODEL_NAME_PATTERN.test(model)) {
+    return `model "${model}" contains characters outside the allowlist [a-zA-Z0-9._-]`;
+  }
+  if (!MODEL_NAME_PATTERN.test(replacement)) {
+    return `replacement "${replacement}" contains characters outside the allowlist [a-zA-Z0-9._-]`;
+  }
+  if (model === replacement) {
+    return `model and replacement are identical ("${model}")`;
+  }
+  return null;
+}
+
+/**
+ * Returns whether a parsed row is within the scope of this action. Only rows
+ * mapping a deprecated `gemini-` model to a replacement `gemini-` model are
+ * ever applied. Out-of-scope rows (e.g. `text-embedding-004` ->
+ * `gemini-embedding-2`) are logged and skipped; they are never written into
+ * the repository.
+ */
+export function isInScope(model: string, replacement: string): boolean {
+  return model.startsWith('gemini-') && replacement.startsWith('gemini-');
+}
+
+/**
+ * Parses the deprecations page and extracts in-scope model replacements.
+ *
+ * Throws when the page does not have the expected table structure, so that the
+ * caller can fail closed instead of silently doing nothing — or worse, acting
+ * on a misinterpreted page.
+ */
+export function parseDeprecations(html: string): DeprecationParseResult {
+  const replacements = new Map<string, string>();
+  const skippedRows: string[] = [];
+
+  if (!html.includes('<table') || !html.includes('<tbody')) {
+    throw new Error(
+      'Unexpected deprecations page structure: expected an HTML table with a <tbody>. Refusing to proceed.',
+    );
+  }
+
+  const tbodyRegex = /<tbody[^>]*>([\s\S]*?)<\/tbody>/gi;
+  let tbodyMatch;
+  while ((tbodyMatch = tbodyRegex.exec(html)) !== null) {
+    const tbodyContent = tbodyMatch[1];
+    const trRegex = /<tr[^>]*>([\s\S]*?)<\/tr>/gi;
+    let trMatch;
+    while ((trMatch = trRegex.exec(tbodyContent)) !== null) {
+      const trContent = trMatch[1];
+      if (!trContent) continue;
+      if (trContent.includes('colspan')) continue;
+
+      const tdRegex = /<td[^>]*>([\s\S]*?)<\/td>/gi;
+      const tds: string[] = [];
+      let tdMatch;
+      while ((tdMatch = tdRegex.exec(trContent)) !== null) {
+        tds.push(tdMatch[1].trim());
+      }
+
+      // Rows with fewer than four cells do not match the documented table
+      // shape (model, description, date, replacement) and are skipped.
+      if (tds.length < 4) {
+        skippedRows.push(`row with ${tds.length} cell(s) instead of 4`);
+        continue;
+      }
+
+      const modelMatch = tds[0].match(/<code[^>]*>([^<]+)<\/code>/);
+      const model = modelMatch ? modelMatch[1].trim() : tds[0].replace(/<[^>]*>/g, '').trim();
+
+      const replacementMatch = tds[3].match(/<code[^>]*>([^<]+)<\/code>/);
+      const replacement = replacementMatch
+        ? replacementMatch[1].trim()
+        : tds[3].replace(/<[^>]*>/g, '').trim();
+
+      // A data row that is missing the model or the replacement value is not
+      // a deprecation entry (e.g. the page also lists newly released models in
+      // the same table shape, with an empty replacement column). It is logged
+      // and skipped; it must never be written into the repository.
+      if (!model || !replacement) {
+        skippedRows.push(`row with empty model or replacement value`);
+        continue;
+      }
+
+      if (!isInScope(model, replacement)) {
+        skippedRows.push(`${model} -> ${replacement} (out of scope)`);
+        continue;
+      }
+      replacements.set(model, replacement);
+    }
+  }
+
+  return {replacements, skippedRows};
+}
+
+/** Builds a word-boundary-aware regex that only matches whole model names. */
+function buildReplacementRegex(model: string): RegExp {
+  const escapedOldModel = model.replaceAll(/[.*+?^${}()|[\]\\]/g, '\\$&');
+  return new RegExp(`(?<![a-zA-Z0-9.-])${escapedOldModel}(?![a-zA-Z0-9.-])`, 'g');
+}
+
+export async function run(): Promise<void> {
+  core.info(`Fetching Gemini deprecations page from ${DEPRECATIONS_URL}...`);
+  let html = '';
+  try {
+    const response = await fetch(DEPRECATIONS_URL, {headers: {accept: 'text/html'}});
+    if (!response.ok) {
+      throw new Error(`Failed to fetch deprecations page: HTTP ${response.status} ${response.statusText}`);
+    }
+    const contentType = response.headers.get('content-type') ?? '';
+    if (!contentType.toLowerCase().startsWith('text/html')) {
+      throw new Error(
+        `Unexpected response from deprecations page: content-type "${contentType}" is not text/html.`,
+      );
+    }
+    html = await response.text();
+    if (html.trim().length === 0) {
+      throw new Error('Deprecations page returned an empty body.');
+    }
+  } catch (error) {
+    core.setFailed(`Error fetching deprecations page: ${error}`);
+    return;
+  }
+
+  let result: DeprecationParseResult;
+  try {
+    result = parseDeprecations(html);
+  } catch (error) {
+    core.setFailed(`Failed to parse deprecations page: ${error}`);
+    return;
+  }
+
+  for (const skipped of result.skippedRows) {
+    core.info(`Skipping out-of-scope row: ${skipped}`);
+  }
+
+  if (result.replacements.size === 0) {
+    core.info('No in-scope gemini model replacements found on the deprecations page.');
+    return;
+  }
+
+  // Fail closed on ANY invalid in-scope pair before touching the repository.
+  const validationErrors: string[] = [];
+  for (const [oldModel, newModel] of result.replacements.entries()) {
+    const error = validatePair(oldModel, newModel);
+    if (error !== null) {
+      validationErrors.push(`  - "${oldModel}" -> "${newModel}": ${error}`);
+    }
+  }
+  if (validationErrors.length > 0) {
+    core.setFailed(
+      `Refusing to update models: ${validationErrors.length} invalid replacement pair(s) found on the ` +
+        `deprecations page. No files were modified.\n${validationErrors.join('\n')}`,
+    );
+    return;
+  }
+
+  core.info(`Found ${result.replacements.size} in-scope model replacement(s) on the deprecations page.`);
+  for (const [oldModel, newModel] of result.replacements.entries()) {
+    core.info(`  - ${oldModel} -> ${newModel}`);
+  }
+
+  // Phase 1: read every target file. Any failure aborts before anything is
+  // written, so a failing file can never cause a silent partial rewrite.
+  const fileContents = new Map<string, string>();
+  for (const file of TARGET_FILES) {
+    try {
+      fileContents.set(file, await readFile(file, 'utf-8'));
+    } catch (err) {
+      if ((err as NodeJS.ErrnoException)?.code === 'ENOENT') {
+        core.info(`Skipping "${file}": file does not exist (add it to TARGET_FILES when it holds model strings).`);
+        continue;
+      }
+      core.setFailed(`Failed to read target file "${file}": ${err}`);
+      return;
+    }
+  }
+
+  // Phase 2: compute and write the updated content for the explicit target
+  // list. The strict charset validation above guarantees every replacement is
+  // a plain `[a-zA-Z0-9._-]` token, which is safe in TypeScript string
+  // literals and YAML scalars without additional escaping.
+  let totalUpdated = 0;
+  for (const [file, content] of fileContents.entries()) {
+    let updatedContent = content;
+    let fileChanged = false;
+    for (const [oldModel, newModel] of result.replacements.entries()) {
+      const newContent = updatedContent.replace(buildReplacementRegex(oldModel), newModel);
+      if (newContent !== updatedContent) {
+        updatedContent = newContent;
+        fileChanged = true;
+        core.info(`Found reference to deprecated model "${oldModel}" in ${file}.`);
+      }
+    }
+    if (fileChanged) {
+      try {
+        await writeFile(file, updatedContent, 'utf-8');
+        core.info(`Updated ${file}`);
+        totalUpdated++;
+      } catch (err) {
+        core.setFailed(`Failed to write file ${file}: ${err}`);
+        return;
+      }
+    }
+  }
+
+  if (totalUpdated === 0) {
+    core.info('No deprecated model references found in the target files. All up to date! 🎉');
+  } else {
+    core.info(`Successfully updated ${totalUpdated} file(s).`);
+  }
+}
