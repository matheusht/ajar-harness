# Derived from Moby v28.0.4 profiles/apparmor/template.go at
# 6430e49a55babd9b8f4d08e70ecb2b68900770fe.
# Static candidate only. Not loaded or parser-validated.
#include <tunables/global>

profile oslit-codex-tool-v1 flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network,
  capability,
  file,
  umount,
  # Host (privileged) processes may send signals to container processes.
  signal (receive) peer=unconfined,
  # runc may send signals to container processes (for "docker stop").
  signal (receive) peer=runc,
  # crun may send signals to container processes (for "docker stop" when using crun).
  signal (receive) peer=crun,
  # Docker daemon is expected to run unconfined; host preflight must verify this.
  signal (receive) peer=unconfined,
  # Container processes may send signals amongst themselves.
  signal (send,receive) peer=oslit-codex-tool-v1,

  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9],[^1-9][^0-9],[^1-9s][^0-9y][^0-9s],[^1-9][^0-9][^0-9][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  # Moby's template has "deny mount," here; this candidate is named and scoped
  # only to the Codex tool container. Kernel capabilities must still reject
  # mount operations before bwrap creates its user/mount namespaces.
  mount,
  pivot_root,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  ptrace (trace,read,tracedby,readby) peer=oslit-codex-tool-v1,
}
