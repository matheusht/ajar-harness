+      return rejectExclusiveCa("digest_mismatch")
+    return { timeout: false, tls: { ca, rejectUnauthorized: true } }
+  } finally {
+    try {
+      closeSync(descriptor)
+    } catch {
+      rejectExclusiveCa("close_failed")
+    }
