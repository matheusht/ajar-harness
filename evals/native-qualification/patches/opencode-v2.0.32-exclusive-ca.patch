+const MAX_EXCLUSIVE_CA_BYTES = 4 * 1024 * 1024
+
+function exclusiveRequestInit(): BunFetchRequestInit {
+  const path = process.env.OPENCODE_EXCLUSIVE_CA_FILE
+  const expected = process.env.OPENCODE_EXCLUSIVE_CA_SHA256
+  if (path === undefined) throw new Error("OPENCODE_EXCLUSIVE_CA_FILE is required")
+  if (path !== EXCLUSIVE_CA_PATH) throw new Error("OPENCODE_EXCLUSIVE_CA_FILE must name the fixed runtime CA path")
+  if (expected === undefined) throw new Error("OPENCODE_EXCLUSIVE_CA_SHA256 is required")
+  if (!/^[0-9a-f]{64}$/.test(expected)) throw new Error("OPENCODE_EXCLUSIVE_CA_SHA256 must be lowercase SHA-256")
