+const EXCLUSIVE_CA_PATH = "/fixture/runtime-ca.pem"
+const MAX_EXCLUSIVE_CA_BYTES = 4 * 1024 * 1024
+const EXCLUSIVE_CA_REJECTION_PREFIX = "OPENCODE_EXCLUSIVE_CA_REJECT:"
+
+class ExclusiveCaRejection extends Error {}
+
+function rejectExclusiveCa(code: string): never {
+  throw new ExclusiveCaRejection(EXCLUSIVE_CA_REJECTION_PREFIX + code)
+}
+
+function normalizeExclusiveCaError(error: unknown) {
+  return error instanceof ExclusiveCaRejection
+    ? error
+    : new ExclusiveCaRejection(EXCLUSIVE_CA_REJECTION_PREFIX + "internal")
+}
+
+function openExclusiveCa(path: string) {
+  try {
+    return openSync(path, constants.O_RDONLY | constants.O_NOFOLLOW | constants.O_NONBLOCK)
+  } catch {
+    return rejectExclusiveCa("open_failed")
+  }
+}
+
+function statExclusiveCa(descriptor: number) {
+  try {
+    return fstatSync(descriptor)
+  } catch {
+    return rejectExclusiveCa("read_failed")
+  }
+}
+
+function readExclusiveCa(descriptor: number, input: Buffer, offset: number, length: number) {
+  try {
+    return readSync(descriptor, input, offset, length, null)
+  } catch {
+    return rejectExclusiveCa("read_failed")
+  }
+}
+
+function exclusiveRequestInit(): BunFetchRequestInit {
+  const path = process.env.OPENCODE_EXCLUSIVE_CA_FILE
+  const expected = process.env.OPENCODE_EXCLUSIVE_CA_SHA256
+  if (path === undefined) return rejectExclusiveCa("path_required")
+  if (path !== EXCLUSIVE_CA_PATH) return rejectExclusiveCa("path_fixed")
+  if (expected === undefined) return rejectExclusiveCa("digest_required")
+  if (!/^[0-9a-f]{64}$/.test(expected)) return rejectExclusiveCa("digest_format")
+
+  const descriptor = openExclusiveCa(path)
+  try {
+    const before = statExclusiveCa(descriptor)
+    if (!before.isFile() || before.size === 0 || before.size > MAX_EXCLUSIVE_CA_BYTES)
+      return rejectExclusiveCa("size_invalid")
+    const input = Buffer.allocUnsafe(MAX_EXCLUSIVE_CA_BYTES + 1)
+    let length = 0
+    while (length < input.length) {
+      const count = readExclusiveCa(descriptor, input, length, input.length - length)
+      if (count === 0) break
+      length += count
+    }
+    if (length === 0 || length > MAX_EXCLUSIVE_CA_BYTES)
+      return rejectExclusiveCa("size_invalid")
+    const ca = input.subarray(0, length)
+    const after = statExclusiveCa(descriptor)
+    if (
