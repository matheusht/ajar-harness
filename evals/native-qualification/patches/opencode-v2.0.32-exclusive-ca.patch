+    const input = Buffer.allocUnsafe(MAX_EXCLUSIVE_CA_BYTES + 1)
+    let length = 0
+    while (length < input.length) {
+      const count = readSync(descriptor, input, length, input.length - length, null)
+      if (count === 0) break
+      length += count
+    }
+    if (length === 0 || length > MAX_EXCLUSIVE_CA_BYTES)
+      throw new Error("Exclusive runtime CA is empty or too large")
+    const ca = input.subarray(0, length)
